                                </td>
                                <td align="left" valign="middle" style="padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                    <span class="text-nowrap" t-field="line.price_unit">9.00</span>
                                </td>
                                <td align="left" valign="middle" style="padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                    <span class="text-nowrap" t-field="line.discount">0</span>
                                </td>
                                <td align="left" valign="middle" style="padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                     <span class="text-nowrap" t-field="line.price_subtotal">27.00</span>
                                </td>
                            </tr>
                            <tr style="border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                <td colspan="8" align="center" valign="middle" style="padding-left:5px;border-bottom: 1px solid black;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                    <table>
                                        <tr t-foreach="line.get_taxes_line_details()" t-as="txline" style="padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                            <td colspan="2" style="padding-left:7px;padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                                <strong> Impuesto: </strong><i> <span t-raw="txline[0]"/> </i> 
