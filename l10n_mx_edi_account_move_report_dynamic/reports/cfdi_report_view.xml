                                <span t-field="line.name" t-options="{'widget': 'text'}">A note, whose content usually applies to the section or product above.</span>
                            </td>
                        </t>
                    </t>
                </tbody>
            </table>
            <br/>
            <table width="100%" style="border-collapse: collapse;padding: 5px;border: 0px solid #FFFFFF; font-size:14px;" id="company_address_data">
            <tr style="border-bottom: 1px solid  transparent;">
                <td width="35%" align="left" valign="middle" style="padding-right:5px;">
                    <strong>MONEDA: </strong><span t-field="o.currency_id.name" /> <br/>
