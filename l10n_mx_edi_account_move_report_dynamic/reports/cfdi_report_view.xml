                        <td width="10%" align="center" valign="middle" style="padding-left:5px;border-bottom: 1px solid black;border-top: 1px solid black;border-left: 1px solid black;border-right: 1px solid black;">
                            <strong>
                                <span>Total</span>
                            </strong>
                        </td>
