                                            <td style="padding-left:7px;padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                                <strong> Factor: </strong><i> <span t-raw="txline[1]"/> </i> 
                                            </td>
                                            <td style="padding-left:7px;padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                                <strong> Base: </strong><i> <span t-raw="'%.2f' % (txline[2])"/> </i>
                                            </td>
                                            <td style="padding-left:7px;padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
