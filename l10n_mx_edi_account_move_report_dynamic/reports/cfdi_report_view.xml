<template id="external_layout_header_account_standard_benotto">
    <div class="header">
        <table width="100%" style="border-collapse: collapse;padding: 5px;border: 0px solid #FFFFFF; font-size:14px;" id="company_address_data">
            <tr style="border-bottom: 1px solid  transparent;">
                <td width="25%" style="vertical-align: middle;text-align: center;">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" style="max-height: 100px;height: auto;"/>
                    <br/>
                </td>
                
                <td width="35%" align="center" valign="top">
                    <h4><span t-field="o.company_id.partner_id.name"/></h4>
                    <br/>
                        <span t-field="o.company_id.partner_id.street"/> 
                        <span t-field="o.company_id.partner_id.street_name"/>
                        <span t-if="o.company_id.partner_id.street_number"> No. <span t-field="o.company_id.partner_id.street_number"/></span>
                        <span t-if="o.company_id.partner_id.street_number2"> Int. <span t-field="o.company_id.partner_id.street_number2"/></span>
                        <br t-if="o.company_id.partner_id.street_number2"/>
                        <span t-if="o.company_id.partner_id.city">
                            <span t-field="o.company_id.partner_id.city"/>,
                        </span>
                        <br/>
                        <span t-field="o.company_id.partner_id.state_id.name"/>, 
                        <span t-field="o.company_id.partner_id.country_id.name"/>
                        <span t-if="o.company_id.partner_id.zip">
                            C.P. <span t-field="o.company_id.partner_id.zip"/>
                        </span>
                        <br/>
                        <strong>RFC Emisor: </strong> <span t-field="o.company_id.partner_id.vat" /><br/>
                        <strong>Régimen Fiscal: </strong> <span t-esc="o.company_id.partner_id.l10n_mx_edi_fiscal_regime" /> - <span t-field="o.company_id.partner_id.l10n_mx_edi_fiscal_regime" />
                </td>
                <td width="40%" align="right" valign="middle" style="padding-right:5px;">
                    <h4>Factura - <span t-field="o.name" /> </h4>
                    <strong>
                        FOLIO FISCAL (UUID)
                    </strong><br/>
                    <span t-out="cfdi_values.get('uuid')">No identificado</span><br/>
                    <strong>
                        NO. DE SERIE DEL CERTIFICADO DEL SAT
                    </strong><br/>
                    <span t-out="cfdi_values.get('certificate_sat_number')">30001000000500003442</span><br/>
                    <strong>
                        NO. DE SERIE DEL CERTIFICADO DEL EMISOR
                    </strong><br/>
                    <span t-out="cfdi_values.get('certificate_number')">30001000000500003416</span><br/>
                    <strong>
                        FECHA Y HORA DE CERTIFICACIÓN
                    </strong><br/>
                    <span t-out="cfdi_values.get('stamp_date')">2023-09-12</span><br/>
                    <strong>
                        RFC PROVEEDOR DE CERTIFICACIÓN
                    </strong><br/>
                    LSO1306189R5<br/>
                    <strong>
                        FECHA Y HORA DE EMISIÓN DE CFDI
                    </strong><br/>
                    <span t-out="cfdi_values.get('emission_date_str')">2023-09-12</span><br/>
                    <strong>
                        LUGAR DE EXPEDICIÓN
                    </strong><br/>
                    <span t-out="cfdi_values.get('expedition')">20928</span>
                </td>
            </tr>
        </table>


    </div>
</template>


