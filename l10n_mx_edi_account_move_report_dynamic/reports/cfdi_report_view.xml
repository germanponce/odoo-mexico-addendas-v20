                            E - EGRESO
                        </span> <br/>
                    <strong>CONDICIONES DE PAGO: </strong>
                        <span id="payment_terms_note_id" t-if="o.invoice_payment_term_id.note" t-field="o.invoice_payment_term_id.note" name="payment_term">Payment within 30 calendar day</span>
                    <br/>
                    <strong>TIPO DE CAMBIO: </strong><span t-esc="o.get_tipo_cambio()" /> <br/>
                    <strong>OBSERVACIONES: </strong><br/>
                    <span t-field="o.narration" /> <br/>
                </td>

                <td width="65%" align="center" valign="top">
                        
                    <div id="total" class="clearfix row">
                        <div class="ms-auto">
                            <table class="table table-sm table-borderless avoid-page-break-inside">

                                                                <!-- ── TOTALES — campos directos del modelo (estables en todas las versiones) ── -->
                                <tr>
                                    <td>Subtotal</td>
                                    <td class="text-end">
                                        <span t-out="'%.2f' % (o.amount_untaxed or 0.0)"/>
                                    </td>
                                </tr>
                                <t t-foreach="o.line_ids.filtered(lambda l: l.tax_line_id and not l.display_type)" t-as="tax_line">
                                    <tr>
                                        <td>
                                            <span t-out="tax_line.tax_line_id.name"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="'%.2f' % abs(tax_line.price_total or 0.0)"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="fw-bold border-top">
                                    <td>Total</td>
                                    <td class="text-end">
                                        <span t-out="'%.2f' % (o.amount_total or 0.0)"/>
                                    </td>
                                </tr>

                                <!--Payments-->
                                <t t-if="print_with_payments">
                                    <t t-if="o.payment_state != 'invoicing_legacy'">
                                        <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                        <t t-foreach="payments_vals" t-as="payment_vals">
                                            <tr t-if="payment_vals['is_exchange'] == 0">
                                                <td>
                                                    <i class="oe_form_field text-end oe_payment_label">Paid on <t t-out="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}">2021-09-19</t></i>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="'%.2f' % (payment_vals['amount'] or 0.0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="len(payments_vals) &gt; 0">
                                            <tr class="border-black fw-bold">
                                                <td>Amount Due</td>
                                                <td class="text-end">
                                                    <span t-out="'%.2f' % (o.amount_residual or 0.0)">11.05</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </table>
                        </div>
                    </div>
                    <div class="mb-2">
                        <p class="text-end lh-sm" t-if="o.company_id.display_invoice_amount_total_words">
                            <small class="text-muted lh-sm"><span t-field="o.amount_total_words">Thirty one dollar and Five cents</span></small>
                        </p>
                    </div>
                    <!-- <t t-call="account.document_tax_totals_company_currency_template"/> -->

                </td>
            </tr>
        </table>

            <div class="row col-12" id='complement'>
                <div class="barcode col-3">
                    <img alt="Barcode" t-att-src="cfdi_values.get('barcode_src')"/>
                </div>
                <div class="complement-details col-9">
                    <div class="digital-stamp">
                        <span>Sello digital del emisor</span>
                    </div>
                    <div class="digital-stamp-content">
                        <span t-out="cfdi_values.get('sello')">No identificado</span>
                    </div>
                    <div class="digital-stamp">
                        <span>Sello digital del SAT</span>
                    </div>
                    <div class="digital-stamp-content">
                        <span t-out="cfdi_values.get('sello_sat')">No identificado</span>
                    </div>
                    <div class="digital-stamp">
                        <span>Cadena original del complemento del certificado digital del SAT</span>
                    </div>
                    <div class="digital-stamp-content">
                        <span class="nowrap" t-out="cfdi_values.get('cadena')">No identificado</span>
                    </div>
                    <div class="digital-stamp-content text-center">
                        <strong style="font-size: 14px;">"NO SE ACEPTAN DEVOLUCIONES"</strong><br/>
                        <strong style="font-size: 14px;">"Garantía válida en un plazo no mayor a 90 días después de la fecha de compra"</strong>
                    </div>
                </div>
            </div>

        </div>  

        <div class="footer">

            <table style="width: 100%">
                <tr >
                    <td  align="center" style="font-size: 12px;width: 65%;text-align: center;border: 1px solid transparent;border-collapse: collapse;padding: 1px;border-bottom: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                        Este documento es una representación impresa de un CFDI. (EF196097)
                    </td>
                    <td style="width: 35%;text-align: right;border: 1px solid transparent;border-collapse: collapse;padding: 1px;border-bottom: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">

                         <strong  style="font-size: 12px;text-align: center;" ><span>   Página </span><span class="page" /> de <span class="topage" /></strong>                       
                    </td>
                </tr>
            </table>

        </div>
    </t>
</template>

