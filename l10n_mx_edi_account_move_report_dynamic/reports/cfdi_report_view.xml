                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                    <t t-foreach="lines" t-as="line">
                        <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                            <tr style="border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                <td align="left" valign="middle" style="padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
                                    <span t-field="line.product_id.default_code">NA</span>
                                </td>
                                <td align="left" valign="middle" style="padding-left:5px;border-bottom: 1px solid transparent;border-top: 1px solid transparent;border-left: 1px solid transparent;border-right: 1px solid transparent;">
