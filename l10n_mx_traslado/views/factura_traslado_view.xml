<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vistas Especiales para el La Mercancia del Traslado -->

        <record id="view_fatura_global_merchandise_line_tree" model="ir.ui.view">
            <field name="name">Lineas CFDI Traslado tree</field>
            <field name="model">cfdi.traslado.line</field>
            <field name="arch" type="xml">
                <list editable="bottom" multi_edit="1" open_form_view="True">
                    <control>
                        <create string="Agregar línea"/>
                    </control>

                    <field name="currency_id" column_invisible="True"/>
                    <field name="cfdi_traslado_id" column_invisible="True"/>

                    <field name="product_id" string="Producto" optional="show"/>
                    <field name="name" string="Descripción" optional="show"/>
                    <field name="quantity" string="Cantidad" optional="show"/>
                    <field name="pesoenkg" optional="show"/>
                    <field name="moneda" optional="hide"/>

                    <!-- Pedimento directo -->
                    <field name="tipo_documento_id"
                           string="Tipo Doc."
                           optional="show"/>
                    <field name="pedimento"
                           string="No. Pedimento"
                           optional="show"/>
                    <field name="fecha_pedimento"
                           string="Fecha Pedimento"
                           optional="show"/>
                    <field name="aduana_pedimento"
                           string="Aduana"
                           optional="show"/>

                    <field name="id_doc_aduanero"
                           string="Identificador documento aduanero"
                           optional="show"/>
                    <field name="rfc_import"
                           string="RFC de importador"
                           optional="show"/>

                    <field name="aduana_pedimento"
                           string="Aduana"
                           optional="show"/>

                    <field name="invoice_line_tax_ids"
                           widget="many2many_tags"
                           column_invisible="True"/>
                    <field name="price_unit"
                           string="Precio Unitario"
                           optional="hide"/>
                    <field name="price_subtotal"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"
                           optional="hide"/>
                    <field name="guias_line_ids"
                           widget="many2many_tags"
                           column_invisible="parent.manejodeguias != True"
                           domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                    <field name="aduanera_line_ids"
                           widget="many2many_tags"
                           column_invisible="parent.transpinternac != 'Sí'"
                           domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                    <field name="transporta_line_ids"
                           widget="many2many_tags"
                           column_invisible="parent.manejodeids != True"
                           domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                </list>
            </field>
        </record>
    
        <record id="view_fatura_global_merchandise_line_form" model="ir.ui.view">
            <field name="name">Lineas CFDI Traslado Form</field>
            <field name="model">cfdi.traslado.line</field>
            <field name="arch" type="xml">
                <form string="Detalle de mercancía">
                    <sheet>

                        <!-- ── Sección: Producto ── -->
                        <group string="Producto">
                            <group>
                                <field name="product_id" string="Producto"/>
                                <field name="name" string="Descripción"/>
                                <field name="quantity" string="Cantidad"/>
                                <field name="pesoenkg" string="Peso en Kg"/>
                                <field name="moneda" string="Moneda"/>
                            </group>
                            <group>
                                <field name="price_unit" string="Precio Unitario"/>
                                <field name="price_subtotal"
                                       string="Subtotal"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="cfdi_traslado_id" invisible="1"/>
                                <field name="invoice_line_tax_ids"
                                       widget="many2many_tags"
                                       string="Impuestos"/>
                            </group>
                        </group>

                        <!-- ── Sección: Pedimento aduanero ── -->
                        <group string="Información Aduanera (Pedimento)">
                            <group>
                                <field name="tipo_documento_id"
                                       string="Tipo de Documento"/>
                                <field name="pedimento"
                                       string="Número de Pedimento"
                                       placeholder="Ej: 25 47 1714 5012787"/>
                            </group>
                            <group>
                                <field name="fecha_pedimento"
                                       string="Fecha del Pedimento"/>
                                <field name="aduana_pedimento"
                                       string="Aduana"
                                       placeholder="Ej: AEROPUERTO INTERNACIONAL LIC. BENITO JUAREZ"/>
                                <field name="id_doc_aduanero"
                                       string="Identificador documento aduanero"
                                       optional="show"/>
                                <field name="rfc_import"
                                       string="RFC de importador"
                                       optional="show"/>
                            </group>
                        </group>

                        <!-- ── Sección: Cantidad transporta ── -->
                        <group string="Cantidad Transporta (IDOrigen / IDDestino)">
                            <field name="transporta_line_ids"
                                   nolabel="1">
                                <list editable="bottom">
                                    <control>
                                        <create string="Agregar tramo"/>
                                    </control>
                                    <field name="cantidad"
                                           string="Cantidad"/>
                                    <field name="idorigen"
                                           string="ID Origen (OR000001)"/>
                                    <field name="iddestino"
                                           string="ID Destino (DE000001)"/>
                                    <field name="cves_transporte"
                                           string="Clave Transporte"/>
                                    <field name="name"
                                           string="Referencia"
                                           optional="show"/>
                                </list>
                            </field>
                        </group>

                        <!-- ── Sección: Documentación aduanera adicional ── -->
                        <group string="Documentación Aduanera Adicional (Comercio Exterior)">
                            <field name="aduanera_line_ids"
                                   nolabel="1">
                                <list editable="bottom">
                                    <control>
                                        <create string="Agregar pedimento"/>
                                    </control>
                                    <field name="tipo_documento_id"
                                           string="Tipo Documento"/>
                                    <field name="pedimento"
                                           string="No. Pedimento"/>
                                    <field name="fecha_pedimento"
                                           optional="show"/>
                                    <field name="aduana_pedimento"
                                           optional="show"/>
                                    <field name="id_doc_aduanero"
                                           string="ID Doc. Aduanero"
                                           optional="show"/>
                                    <field name="rfc_import"
                                           string="RFC Importador"
                                           optional="show"/>
                                </list>
                            </field>
                        </group>

                        <!-- ── Sección: Guías ── -->
                        <group string="Guías de Identificación">
                            <field name="guias_line_ids"
                                   nolabel="1">
                                <list editable="bottom">
                                    <control>
                                        <create string="Agregar guía"/>
                                    </control>
                                    <field name="guiaid_numero"
                                           string="No. Guía"/>
                                    <field name="guiaid_descrip"
                                           string="Descripción"/>
                                    <field name="guiaid_peso"
                                           string="Peso (Kg)"/>
                                </list>
                            </field>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cfdi_traslado_line" model="ir.actions.act_window">
            <field name="name">Mercancias de Traslado</field>
            <field name="res_model">cfdi.traslado.line</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_fatura_global_merchandise_line_tree"/>
        </record>

        <!-- Vistas Especiales para el CFDI de Traslado -->
        <record id="view_fatura_global_form" model="ir.ui.view">
            <field name="name">CFDI Traslado form</field>
            <field name="model">cfdi.traslado</field>
            <field name="arch" type="xml">
                <form string="CFDI Traslado">
                    <header>
                        <field name="factura_cfdi" invisible="1"/>
                        <button name="action_valid" type="object"
                                invisible="state != 'draft'"
                                string="Validar" class="oe_highlight"/>
                        <button name="action_set_draft" type="object"
                                invisible="state != 'cancel'"
                                string="Cambiar a borrador" class="oe_highlight"/>
                        <button name="action_cancel" string="Cancelar" type="object"
                                invisible="state in ['draft','cancel']"/>
                        <button name="action_cfdi_generate" type="object"
                                string="Generar CFDI"
                                invisible="factura_cfdi == True or state != 'valid'"
                                class="oe_highlight" groups="base.group_user"/>
                        <button name="%(l10n_mx_traslado.reason_cancelation_sat_wizard)d"
                                type="action"
                                string="Cancelar CFDI"
                                invisible="factura_cfdi == False or estado_factura in ['solicitud_cancelar', 'factura_cancelada', 'solicitud_rechazada']"
                                class="oe_highlight" groups="base.group_user"/>
                        <button name="send_factura_mail" class="oe_highlight"
                                invisible="estado_factura == 'factura_no_generada'"
                                string="Enviar por correo-e" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,valid,cancel"/>
                    </header>

                    <sheet>
                        <div>
                            <h1 class="mt0">
                                <field name="number" class="oe_inline"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="partner_id" readonly="state == 'valid'"/>
                                <field name="source_document" readonly="state == 'valid'"/>
                            </group>
                            <group>
                                <field name="invoice_date" readonly="state == 'valid'"/>
                                <field name="tipo_transporte" readonly="state == 'valid'"/>
                                <field name="carta_porte" readonly="state == 'valid'"/>
                            </group>
                        </group>

                        <notebook>
                            <!-- ══════════════════════════════════════════════
                                 PESTAÑA: Mercancía a trasladar
                                 ────────────────────────────────────────────
                                 CAMBIOS:
                                 · Se agregan columnas de pedimento directo en línea:
                                   tipo_documento_id, pedimento, fecha_pedimento,
                                   aduana_pedimento (pre-llenadas desde el picking).
                                 · El campo aduanera_line_ids en la lista se mantiene
                                   para comercio exterior; para traslados nacionales
                                   se usa el pedimento directo de la línea.
                                 · Se agrega el campo cves_transporte en
                                   transporta_line_ids.
                            ══════════════════════════════════════════════ -->
                            <page name="invoice_line_factura" string="Mercancía a trasladar">
                                <field name="factura_line_ids" readonly="state == 'valid'">

                                    <!-- ══════════════════════════════════════
                                         VISTA LISTA — columnas principales
                                    ══════════════════════════════════════ -->
                                    <list editable="bottom" multi_edit="1" open_form_view="True">
                                        <control>
                                            <create string="Agregar línea"/>
                                        </control>

                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="cfdi_traslado_id" column_invisible="True"/>

                                        <field name="product_id" string="Producto" optional="show"/>
                                        <field name="name" string="Descripción" optional="show"/>
                                        <field name="quantity" string="Cantidad" optional="show"/>
                                        <field name="pesoenkg" optional="show"/>
                                        <field name="moneda" optional="hide"/>

                                        <!-- Pedimento directo -->
                                        <field name="tipo_documento_id"
                                               string="Tipo Doc."
                                               optional="show"/>
                                        <field name="pedimento"
                                               string="No. Pedimento"
                                               optional="show"/>
                                        <field name="fecha_pedimento"
                                               string="Fecha Pedimento"
                                               optional="show"/>
                                        <field name="aduana_pedimento"
                                               string="Aduana"
                                               optional="show"/>

                                        <field name="invoice_line_tax_ids"
                                               widget="many2many_tags"
                                               column_invisible="True"/>
                                        <field name="price_unit"
                                               string="Precio Unitario"
                                               optional="hide"/>
                                        <field name="price_subtotal"
                                               widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               optional="hide"/>
                                        <field name="guias_line_ids"
                                               widget="many2many_tags"
                                               column_invisible="parent.manejodeguias != True"
                                               domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                                        <field name="aduanera_line_ids"
                                               widget="many2many_tags"
                                               column_invisible="parent.transpinternac != 'Sí'"
                                               domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                                        <field name="transporta_line_ids"
                                               widget="many2many_tags"
                                               column_invisible="parent.manejodeids != True"
                                               domain="[('cfdi_traslado_id','=',cfdi_traslado_id)]"/>
                                    </list>

                                    <!-- ══════════════════════════════════════
                                         SUBVISTA FORMULARIO — se abre al hacer
                                         clic en el ícono externo de la línea
                                    ══════════════════════════════════════ -->
                                </field>

                                <!-- Subtotales -->
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="amount_untaxed" string="Subtotal"/>
                                    <field name="amount_tax" invisible="1"/>
                                    <field name="amount_total"
                                           class="oe_subtotal_footer_separator"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           string="Total"/>
                                </group>

                                <!-- Inf. Aduanera (solo Comercio Exterior) -->
                                <field name="aduanera_line_ids"
                                       readonly="state == 'valid'"
                                       invisible="transpinternac != 'Sí'">
                                    <list editable="bottom">
                                        <control>
                                            <create string="Agregar línea"/>
                                        </control>
                                        <field name="tipo_documento_id"
                                               string="Tipo Documento"/>
                                        <field name="pedimento"
                                               string="No. Pedimento"/>
                                        <field name="fecha_pedimento"
                                               optional="show"/>
                                        <field name="aduana_pedimento"
                                               optional="show"/>
                                        <field name="id_doc_aduanero"
                                               string="ID Doc. Aduanero"
                                               optional="show"/>
                                        <field name="rfc_import"
                                               string="RFC Importador"
                                               optional="show"/>
                                    </list>
                                </field>

                                <!-- Guías -->
                                <field name="guias_line_ids"
                                       readonly="state == 'valid'"
                                       invisible="manejodeguias != True">
                                    <list editable="bottom">
                                        <control>
                                            <create string="Agregar línea"/>
                                        </control>
                                        <field name="guiaid_numero"/>
                                        <field name="guiaid_descrip"/>
                                        <field name="guiaid_peso"/>
                                    </list>
                                </field>

                                <!-- ══════════════════════════════════════════
                                     CantidadTransporta
                                     CAMBIO: se agrega columna cves_transporte
                                ══════════════════════════════════════════ -->
                                <field name="transporta_line_ids"
                                       readonly="estado_factura != 'factura_no_generada'"
                                       invisible="manejodeids != True">
                                    <list editable="bottom">
                                        <control>
                                            <create string="Agregar línea"/>
                                        </control>
                                        <field name="name"/>
                                        <field name="cantidad"/>
                                        <field name="idorigen"/>
                                        <field name="iddestino"/>
                                        <!-- ── NUEVO: Clave de transporte (CvesTransporte) ── -->
                                        <field name="cves_transporte"
                                               string="Clave Transporte"
                                               optional="show"/>
                                    </list>
                                </field>

                                <field name="comment" placeholder="Términos y condiciones..."/>
                            </page>

                            <!-- ══════════════════════════════════════════════
                                 PESTAÑA: Información Adicional
                            ══════════════════════════════════════════════ -->
                            <page name="info_adicional" string="Información Adicional">
                                <group cols="4">
                                    <group string="Detalles de Pago">
                                        <field name="company_id" readonly="state == 'valid'"/>
                                        <field name="journal_id" readonly="state == 'valid'"/>
                                        <field name="currency_id" string="Moneda" readonly="state == 'valid'"/>
                                    </group>
                                </group>
                            </page>

                            <!-- ══════════════════════════════════════════════
                                 PESTAÑA: CFDI
                            ══════════════════════════════════════════════ -->
                            <page name="info_cdfi" string="CFDI">
                                <group cols="4">
                                    <group string="Detalles de Pago">
                                        <field name="forma_pago" invisible="1" readonly="state == 'valid'"/>
                                        <field name="methodo_pago" invisible="1" readonly="state == 'valid'"/>
                                        <field name="uso_cfdi" readonly="True"/>
                                    </group>
                                    <group string="Detalles de Factura">
                                        <field name="tipo_comprobante" readonly="True"/>
                                        <field name="folio_fiscal" readonly="True"/>
                                        <field name="confirmacion" readonly="state == 'valid'"/>
                                        <field name="estado_factura"/>
                                        <field name="fecha_factura" readonly="state == 'valid'"/>
                                        <field name="proceso_timbrado"/>
                                    </group>
                                    <group string="CFDI Relacionados">
                                        <field name="tipo_relacion" readonly="state == 'valid'"/>
                                        <field name="uuid_relacionado" readonly="state == 'valid'"/>
                                    </group>
                                </group>
                            </page>

                            <!-- ══════════════════════════════════════════════
                                 PESTAÑA: Carta Porte
                            ══════════════════════════════════════════════ -->
                            <page name="carta_porte" string="Carta Porte" invisible="carta_porte == False">
                                <group cols="4">
                                    <group string="Atributos de carta porte">
                                        <field name="transpinternac" readonly="state == 'valid'"/>
                                        <field name="entradasalidamerc" readonly="state == 'valid'"
                                               invisible="transpinternac != 'Sí'"/>
                                        <field name="viaentradasalida" readonly="state == 'valid'"
                                               invisible="transpinternac != 'Sí'"/>
                                        <field name="uuidcomercioext" readonly="state == 'valid'"
                                               invisible="transpinternac != 'Sí' or entradasalidamerc != 'salida'"/>
                                        <field name="paisorigendestino" readonly="state == 'valid'"
                                               invisible="transpinternac != 'Sí'"/>
                                        <field name="IdCCP"/>
                                        <field name="LogisticaInversa" readonly="state == 'valid'"/>
                                    </group>
                                    <group string="Atributos de mercancías">
                                        <field name="pesobrutototal" readonly="True"/>
                                        <field name="unidadpeso" readonly="state == 'valid'"/>
                                        <field name="pesonetototal" readonly="state == 'valid'"/>
                                        <field name="numerototalmercancias" readonly="True"/>
                                        <!-- ── NUEVO: Distancia total (TotalDistRec) ── -->
                                        <field name="totaldistrec" readonly="True"
                                               string="Total Distancia Recorrida (km)"/>
                                        <field name="manejodeguias" readonly="state == 'valid'"/>
                                        <field name="manejodeids" readonly="state == 'valid'"/>
                                    </group>
                                    <group invisible="transpinternac != 'Sí'">
                                        <field name="aduanero_line_ids" readonly="state == 'valid'">
                                            <list editable="bottom">
                                                <control>
                                                    <create string="Agregar línea"/>
                                                </control>
                                                <field name="regimen_aduanero"/>
                                            </list>
                                        </field>
                                    </group>
                                </group>
                            </page>

                            <!-- ══════════════════════════════════════════════
                                 PESTAÑA: Ubicaciones
                                 CAMBIO: idubicacion siempre visible (antes
                                 requería manejodeids=True). El ID de ubicación
                                 es obligatorio en CartaPorte 3.1.
                            ══════════════════════════════════════════════ -->
                            <page name="ccp_ubicaciones" string="Ubicaciones"
                                  invisible="carta_porte == False">
                                <field name="ubicaciones_line_ids"
                                       readonly="state == 'valid'"
                                       context="{'default_tipo_transporte': tipo_transporte}">
                                    <list editable="bottom">
                                        <control>
                                            <create string="Agregar línea"/>
                                        </control>
                                        <field name="tipo_transporte" column_invisible="1"/>
                                        <field name="tipoubicacion"/>
                                        <field name="contacto"/>
                                        <field name="fecha"/>
                                        <!-- ── CAMBIO: idubicacion siempre visible ── -->
                                        <field name="idubicacion" string="ID Ubicación (OR/DE + 6 dígitos)"/>
                                        <field name="tipoestacion"
                                               column_invisible="parent.tipo_transporte == '01'"/>
                                        <field name="numestacion"
                                               column_invisible="parent.tipo_transporte == '01'"/>
                                        <field name="distanciarecorrida"
                                               column_invisible="parent.tipo_transporte != '01'"/>
                                    </list>
                                </field>
                            </page>

                            <!-- ══════════════════════════════════════════════
                                 PESTAÑA: Datos de transporte
                                 CAMBIO: renombrar campos de seguro de carga
                                 para que coincidan con el modelo actualizado
                                 (nombreaseg_merc → AseguraCarga,
                                  numpoliza_merc  → PolizaCarga).
                            ══════════════════════════════════════════════ -->
                            <page name="ccp_autotransporte" string="Datos de transporte"
                                  invisible="carta_porte == False">
                                <group cols="4">
                                    <group string="Generales">
                                        <field name="permisosct" readonly="state == 'valid'"/>
                                        <field name="numpermisosct" readonly="state == 'valid'"/>
                                    </group>
                                    <group/>
                                    <group string="Autotransporte"
                                           invisible="tipo_transporte != '01'">
                                        <field name="autotrasporte_ids" readonly="state == 'valid'"/>
                                    </group>
                                    <group invisible="tipo_transporte != '01'">
                                        <field name="remolque_line_ids" readonly="state == 'valid'">
                                            <list editable="bottom">
                                                <control>
                                                    <create string="Agregar línea"/>
                                                </control>
                                                <field name="subtipo_id"/>
                                                <field name="placa"/>
                                            </list>
                                        </field>
                                    </group>
                                    <!-- ── CAMBIO: etiquetas actualizadas (AseguraCarga / PolizaCarga) ── -->
                                    <group string="Seguro de la Carga (AseguraCarga / PolizaCarga)"
                                           invisible="tipo_transporte != '01'">
                                        <field name="nombreaseg_merc"
                                               string="Aseguradora de Carga (AseguraCarga)"
                                               readonly="state == 'valid'"/>
                                        <field name="numpoliza_merc"
                                               string="Póliza de Carga (PolizaCarga)"
                                               readonly="state == 'valid'"/>
                                        <field name="primaseguro_merc"
                                               string="Prima del Seguro (PrimaSeguro, opcional)"
                                               readonly="state == 'valid'"/>
                                    </group>
                                    <group string="Seguro medioambiental"
                                           invisible="tipo_transporte != '01'">
                                        <field name="seguro_ambiente" readonly="state == 'valid'"/>
                                        <field name="poliza_ambiente" readonly="state == 'valid'"/>
                                    </group>
                                    <group string="Aéreo" invisible="tipo_transporte != '03'">
                                        <field name="numeroguia" readonly="state == 'valid'"/>
                                        <field name="lugarcontrato" readonly="state == 'valid'"/>
                                        <field name="transportista_id" readonly="state == 'valid'"/>
                                        <field name="embarcador_id" readonly="state == 'valid'"/>
                                        <field name="matriculaaeronave" readonly="state == 'valid'"/>
                                        <field name="cargoportasacion" readonly="state == 'valid'"/>
                                    </group>
                                </group>
                            </page>

                            <!-- ══════════════════════════════════════════════
                                 PESTAÑA: Figura transporte
                                 CAMBIO: se agrega NumLicencia y NumRegIdTrib
                                 visibles como columnas opcionales.
                            ══════════════════════════════════════════════ -->
                            <page name="ccp_figuratrans" string="Figura transporte"
                                  invisible="carta_porte == False">
                                <group string="Figura transporte">
                                    <field name="figuratransporte_ids" readonly="state == 'valid'">
                                        <list editable="bottom">
                                            <control>
                                                <create string="Agregar línea"/>
                                            </control>
                                            <field name="tipofigura"/>
                                            <field name="figura_id"/>
                                            <!-- ── NUEVO: Num. Licencia visible en la lista ── -->
                                            <field name="figura_licencia"
                                                   optional="show"/>
                                            <!-- ── NUEVO: RFC figura ── -->
                                            <field name="figura_rfc"
                                                   optional="show"/>
                                            <field name="partetransporte" widget="many2many_tags"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             VISTA LISTA (sin cambios estructurales)
        ══════════════════════════════════════════════════════════════════ -->
        <record id="view_fatura_global_tree" model="ir.ui.view">
            <field name="name">CFDI Traslado tree</field>
            <field name="model">cfdi.traslado</field>
            <field name="arch" type="xml">
                <list string="CFDI Traslado" default_order="invoice_date desc">
                    <field name="currency_id" column_invisible="True"/>
                    <field name="partner_id"/>
                    <field name="invoice_date"/>
                    <field name="number"/>
                    <field name="source_document"/>
                    <field name="amount_total"
                           sum="amount total"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="estado_factura"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Acción y menú -->
        <record id="action_fatura_global_tree" model="ir.actions.act_window">
            <field name="name">CFDI Traslado</field>
            <field name="res_model">cfdi.traslado</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_fatura_global_tree"/>
        </record>

        <menuitem id="customer_sub_menu_factura_global"
                  name="CFDI Traslado"
                  action="action_fatura_global_tree"
                  parent="account.menu_finance_receivables"
                  sequence="111"/>

        <!-- Acción de servidor: llenar IDs de ubicación automáticamente -->
        <record id="model_action_llenar_ubicaciones" model="ir.actions.server">
            <field name="name">Llenar ID Ubicacion</field>
            <field name="model_id" ref="l10n_mx_traslado.model_cfdi_traslado"/>
            <field name="binding_model_id" ref="l10n_mx_traslado.model_cfdi_traslado"/>
            <field name="state">code</field>
            <field name="code">action = records.llenar_id_ubicacion()</field>
        </record>

    </data>
</odoo>