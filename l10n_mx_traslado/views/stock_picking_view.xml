<?xml version="1.0"?>
<odoo>
    <record id="action_crear_cfdi_traslado" model="ir.actions.server">
        <field name="name">Crear CFDI traslado</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="code">action = records.create_cfdi_traslado()
        </field>
    </record>

    <!-- INHERIT view_partner_form -->
    <record id="stock_landed_cost_l10n_mx_edi_extended_replace" model="ir.ui.view">
        <field name="name">view.stock.landed.cost.form.l10n_mx_stock</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="l10n_mx_edi_landing.view_stock_landed_cost_form_l10n_mx_stock" />
        <field name="arch" type="xml">
            <field name="l10n_mx_edi_customs_number" position="replace"/>
        </field>
    </record>

    <!-- INHERIT view_partner_form -->
    <record id="stock_landed_cost_l10n_mx_edi_extended_reestructure" model="ir.ui.view">
        <field name="name">view.stock.landed.cost.form.l10n_mx_stock</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form" />
        <field name="arch" type="xml">
            <notebook position="before">
                <group string="Información Aduanera">
                    <group>
                        <field name="l10n_mx_edi_customs_number" />
                        <field name="pedimento" invisible="1"/>
                        <field name="fecha_pedimento" />
                        <field name="tipo_documento_id" />
                    </group>
                    <group>
                        <field name="aduana_pedimento" />
                        <field name="id_doc_aduanero" />
                        <field name="rfc_import" />
                    </group>
                </group>
            </notebook>
            <!-- <field name="l10n_mx_edi_customs_number" />
            <field name="pedimento" />
            <field name="fecha_pedimento" />
            <field name="aduana_pedimento" />
            <field name="id_doc_aduanero" />
            <field name="rfc_import" /> -->
        </field>
    </record>

</odoo>