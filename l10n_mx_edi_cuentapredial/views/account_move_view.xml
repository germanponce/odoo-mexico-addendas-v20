<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_l10n_mx_edi_invoice_form_inherit" model="ir.ui.view">
            <field name="name">l10n_mx_edi.invoice.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="after">
                    <field name="l10n_mx_edi_cuenta_predial" optional="hide"  />
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree" position="inside">
                    <field name="l10n_mx_edi_cuenta_predial" invisible="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
