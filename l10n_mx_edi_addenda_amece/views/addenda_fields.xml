<odoo>
    <data>

        <record model="ir.ui.view" id="addenda_amece_product_fields_form">
            <field name="name">addenda_amece_product_fields_form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.product_template_only_form_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="amece" string="Addenda AMECE 7.1 Generales">
                        <group>
                            <field name="x_gtin_amece" />
                        </group>
                        <group>
                        </group>
                    </group>
                    <group name="amece_codes">
                        <separator string="Codigos AMECE 7.1 especificos por Cliente"/>
                        <newline/>
                        <field name="gtin_code_ids" nolabel="1">
                            <list string="Codigos AMECE 7.1" editable="bottom">
                                <field name="partner_id" required="1" options="{'no_create':True, 'no_create_edit':True}"/>
                                <field name="x_gtin_amece" required="1"/>
                            </list>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="addenda_amece_71_company_fields_form">
            <field name="name">addenda_amece_71_company_fields_form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.res_company_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="amece" string="Addenda AMECE 7.1 Generales">
                        <group>
                            <field name="l10n_mx_edi_amece_alternateid"/>
                        </group>
                        <group>
                            <field name="l10n_mx_edi_amece_gln"/>
                        </group>
                    </group>
                    <group name="amece_codes">
                        <separator string="Codigos AMECE 7.1 especificos por Cliente"/>
                        <newline/>
                        <field name="gln_code_ids" nolabel="1">
                            <list string="Codigos AMECE 7.1" editable="bottom">
                                <field name="partner_id" required="1" options="{'no_create':True, 'no_create_edit':True}"/>
                                <field name="l10n_mx_edi_amece_alternateid" required="1"/>
                                <field name="l10n_mx_edi_amece_gln" required="1"/>
                            </list>
                        </field>
                    </group>

                </xpath>
            </field>
        </record>


        <record model="ir.ui.view" id="addenda_amece_71_partner_fields_form">
            <field name="name">addenda_amece_71_partner_fields_form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='fiscal_information']" position="inside">
                    <field name="l10n_mx_edi_amece_gln"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="addenda_amece_71_sale_fields_form">
            <field name="name">addenda_amece_71_sale_fields_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.sale_order_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="amece" string="Addenda AMECE 7.1" 
                        invisible="addenda_type != 'amece'">
                        <group>
                            <field name="l10n_mx_edi_amece_referenceidentification"/>
                            <field name="l10n_mx_edi_amece_referencedate"/>
                            <field name="l10n_mx_edi_amece_additionalinformation"/>
                        </group>
                        <group>
                            <field name="l10n_mx_edi_amece_personordepartmentname"/>
                            <field name="l10n_mx_edi_amece_shipto_id"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="addenda_amece_71_invoice_fields_form">
            <field name="name">addenda_amece_71_invoice_fields_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.account_move_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="amece" string="Addenda AMECE 7.1" invisible="addenda_type != 'amece'">
                        <group>
                            <field name="l10n_mx_edi_amece_referenceidentification"/>
                            <field name="l10n_mx_edi_amece_referencedate"/>
                            <field name="l10n_mx_edi_amece_additionalinformation"/>
                        </group>
                        <group>
                            <field name="l10n_mx_edi_amece_personordepartmentname"/>
                            <field name="l10n_mx_edi_amece_shipto_id"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>



    </data>
</odoo>