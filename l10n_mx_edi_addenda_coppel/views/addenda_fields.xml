							<field name="x_name_warehouse"/>
							<field name="x_warehouse_code"/>
	        			</group>
	        			<group>
							<field name="x_street_warehouse"/>
							<field name="x_city_warehouse" />
							<field name="x_zip_warehouse" />
	        			</group>
	        		</group>
	        		<group invisible="addenda_type != 'coppel'">
						<field name="x_qty_lote"/>
	        			<field name="x_gln"/>
	        		</group>
	        		<group invisible="addenda_type != 'coppel'">
	        			<group>
	        				<field name="x_bodega_destino" />
	        				<field name="x_flete_partner_id" options="{'no_create': True, 'no_create_edit': True}"/>
	        			</group>
	        			<group>
	        				<field name="x_bodega_receptora" />
	        			</group>
	        		</group>
		        </xpath>
		    </field>
		</record>

