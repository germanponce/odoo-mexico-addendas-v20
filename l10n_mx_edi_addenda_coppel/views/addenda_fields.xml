		<record model="ir.ui.view" id="addenda_company_fields_form">
		    <field name="name">addenda_company_fields_form</field>
		    <field name="model">res.company</field>
		    <field name="inherit_id" ref="l10n_mx_edi_addendas_base.res_company_addendas_extra_base"/>
		    <field name="arch" type="xml">
		        <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
	        		<group name="coppel" string="Addenda Coppel">
	        			<group>
	        				<field name="x_supplier_id"/>
	        			</group>
	        			<group>
	        				<field name="x_supplier_type"/>
	        				<field name="x_gln"/>
	        			</group>
	        		</group>
		        </xpath>
		    </field>
		</record>
		
