<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del wizard para adjuntar XML -->
    <record id="view_xml_attachment_wizard_form" model="ir.ui.view">
        <field name="name">xml.attachment.wizard.form</field>
        <field name="model">xml.attachment.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjuntar XML Personalizado">
                <sheet>
                    <group>
                        <field name="document_id" invisible="1"/>
                        <field name="move_id" readonly="1"/>
                        <field name="use_custom_xml"/>
                        <field name="custom_xml_file" 
                               filename="custom_xml_filename"
                               invisible="not use_custom_xml"
                               required="use_custom_xml"/>
                        <field name="custom_xml_filename" invisible="1"/>
                    </group>
                    
                    <div class="alert alert-info" invisible="not use_custom_xml">
                        <strong>Importante:</strong> El XML adjunto se enviará directamente al PAC 
                        sin generar el documento automáticamente desde Odoo.
                    </div>
                    
                    <div class="o_row" invisible="not custom_xml_file">
                        <button name="action_validate_xml" 
                                type="object" 
                                string="Validar XML" 
                                class="btn-secondary"
                                icon="fa-check"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Guardar" 
                            name="action_save_xml_attachment" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancelar" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>