<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario para adjuntar XML (standalone) -->
    <record id="view_l10n_mx_edi_document_xml_form" model="ir.ui.view">
        <field name="name">l10n_mx_edi.document.xml.form</field>
        <field name="model">l10n_mx_edi.document</field>
        <field name="arch" type="xml">
            <form string="Adjuntar XML Personalizado">
                <sheet>
                    <group>
                        <field name="use_custom_xml"/>
                        <field name="custom_xml_file" 
                               filename="custom_xml_filename"
                               invisible="not use_custom_xml"
                               required="use_custom_xml"/>
                        <field name="custom_xml_filename" invisible="1"/>
                    </group>
                    <div class="alert alert-info" invisible="not use_custom_xml">
                        <strong>Importante:</strong> El XML adjunto se enviará directamente al PAC 
                        sin generar el documento automáticamente desde Odoo.
                    </div>
                    <div class="o_row" invisible="not custom_xml_file">
                        <button name="action_validate_custom_xml" 
                                type="object" 
                                string="Validar XML" 
                                class="btn-secondary"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Guardar" special="save" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Herencia de la vista formulario de facturas para mostrar el botón -->
    <record id="view_move_form_inherit_xml_attachment" model="ir.ui.view">
        <field name="name">account.move.form.inherit.xml.attachment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Agregamos el botón en el header de la factura, lugar más seguro -->
            <!-- <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_xml_wizard" 
                        type="object" 
                        class="oe_stat_button"
                        icon="fa-paperclip">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">XML</span>
                        <span class="o_stat_text">Personalizado</span>
                    </div>
                </button>
            </xpath> -->
            <xpath expr="//field[@name='l10n_mx_edi_document_ids']" position="after">
                <div class="o_row">
                    <button name="action_open_xml_wizard" 
                            type="object" 
                            string="Adjuntar XML Personalizado"
                            icon="fa-paperclip"
                            class="btn-secondary"
                            invisible="not l10n_mx_edi_document_ids"/>
                </div>
            </xpath>
            
        </field>
    </record>
</odoo>