<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="view_l10n_mx_edi_retailer_company_form_inherit" model="ir.ui.view">
            <field name="name">l10n_mx_edi.retailer.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.res_company_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group string="Complemento Detallista">
                        <field name="l10n_mx_edi_retailer_buyer_gln"/>
                        <field name="l10n_mx_edi_retailer_seller_gln"/>
                        <field name="l10n_mx_edi_retailer_seller_alternate_party_identification"/>
                        <field name="l10n_mx_edi_retailer_seller_id_type"/>
                        <field name="l10n_mx_edi_retailer_ship_to_gln"/>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
