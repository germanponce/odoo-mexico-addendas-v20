        <record model="ir.ui.view" id="addenda_sale_fields_basware_form">
            <field name="name">addenda_sale_fields_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.sale_order_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="bassware" string="Addenda Bassware" 
                        invisible="addenda_type != 'basware'" >
                        <group>
                            <field name="x_orden_compra"/>
                        </group>
                        <group>
                            <field name="x_numero_contrato"/>
                        </group>
                    </group>
                    <group invisible="addenda_type != 'basware'">
                        <group>
                            <field name="x_persona_referencia"/>
                            <field name="x_email"/>
                            <field name="x_documento_transporte"/>
                        </group>
                        <group>
                            <field name="x_numero_proveedor"/>
                            <field name="x_codigo_destinatario" />
                            <field name="x_iso_moneda" />
                        </group>
                    </group>
                    <group invisible="addenda_type != 'basware'">
                        <field name="x_fecha_pago"/>
                        <field name="x_termino_pago"/>
                    </group>
                    <group string="Atributos" 
                           invisible="addenda_type != 'basware'">
                        <field name="x_extra_info_ids"
                               invisible="addenda_type != 'basware'">
                            <list editable="bottom">
                                <field name="ttype" string="Descripción"/>
                                <field name="value" string="Valor"/>
                            </list>
                            <form>
                                <group>
                                    <field name="ttype" string="Descripción"/>
                                    <field name="value" string="Valor"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="addenda_sale_order_line_fields_bassware_form">
            <field name="name">addenda_sale_fields_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//list/field[@name='price_subtotal']" position="after">
                    <button name="action_open_line_form" type="object" string="Addenda" />
                </xpath>
            </field>
        </record>

