<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- VISTAS PERSONALIZADAS PARA CAMPOS -->

        <record id="sale_order_line_detail_form_view" model="ir.ui.view">
            <field name="name">sale.order.line.detail.form</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <form string="Detalle de Línea de Venta">
                    <sheet>
                        <group>
                            <group>
                                <field name="x_orden_compra"/>
                                <field name="x_linea_orden_compra"/>
                                <field name="x_numero_contrato"/>
                            </group>
                            <group>
                                <field name="x_codido_producto_comprador"/>
                                <field name="x_documento_transporte"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Atributos">
                                <field name="x_extra_info_ids">
                                    <list editable="bottom">
                                        <field name="ttype" string="Descripción"/>
                                        <field name="value" string="Valor"/>
                                    </list>
                                    <form>
                                        <group>
                                            <field name="ttype" string="Descripción"/>
                                            <field name="value" string="Valor"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button string="Guardar y Cerrar" class="btn-primary" special="save"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="account_move_line_detail_form_view" model="ir.ui.view">
            <field name="name">account.move.line.detail.form</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
