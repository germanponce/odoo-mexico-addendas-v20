<odoo>
    <data>


        <record model="ir.ui.view" id="addenda_astra_zeneca_sale_fields_form">
            <field name="name">addenda_astra_zeneca_sale_fields_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.sale_order_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="astra_zeneca" string="Addenda AstraZeneca" 
                        invisible="addenda_type != 'astra_zeneca'">
                        <group>
                            <field name="orden_compra_astra_zeneca"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="addenda_astra_zeneca_invoice_fields_form">
            <field name="name">addenda_astra_zeneca_invoice_fields_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.account_move_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="astra_zeneca" string="Addenda AstraZeneca" 
                        invisible="addenda_type != 'astra_zeneca'">
                        <group>
                            <field name="orden_compra_astra_zeneca"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </xpath>
                <xpath expr='//field[@name="invoice_line_ids"]/list/field[@name="name"]' position="before">
                    <field name="no_identificacion_astra_zeneca" 
                        column_invisible="parent.addenda_type != 'astra_zeneca'"/>
                </xpath>
            </field>
        </record>



    </data>
</odoo>