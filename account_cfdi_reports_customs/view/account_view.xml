        <record id="account_journal_cfdi_report_form_ext" model="ir.ui.view">
            <field name="name">account.journal.cfdi_report</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <notebook position="before">
                    <group>
                        <field name="cfdi_report_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </notebook>
            </field>
        </record>

        <record id="sale_order_cfdi_report_form_ext" model="ir.ui.view">
            <field name="name">sale.order.cfdi_report</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_shipping_id" position="after">
                    <field name="via_embarque" />
                    <field name="no_orden" />
                </field>
            </field>
        </record>

    </data>
</odoo>
