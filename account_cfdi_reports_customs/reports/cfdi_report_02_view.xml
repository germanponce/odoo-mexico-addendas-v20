<template id="external_layout_header_account_standard_edi_02">
    <div class="header">
        <head>
            <style media="screen">
                body {
                    font-family: 'Segoe UI','Microsoft Sans Serif',sans-serif;
                }

                /*
                    These next two styles are apparently the modern way to clear a float. This allows the logo
                    and the word "Invoice" to remain above the From and To sections. Inserting an empty div
                    between them with clear:both also works but is bad style.
                    Reference:
                    http://stackoverflow.com/questions/490184/what-is-the-best-way-to-clear-the-css-style-float
                */
                header:before, header:after {
                    content: " ";
                    display: table;
                }

                header:after {
                    clear: both;
                }

                .invoiceNbr {
                    font-size: 14px;
                    margin-right: 30px;
                    margin-top: 30px;
                    float: right;
                }

                .logo {
                    float: left;
                }

                .from {
                    float: left;
                }

                .to {
                    float: right;
                }

                .fromto {
                    border-style: solid;
                    border-width: 1px;
                    border-color: black;
                    border-radius: 10px;
                    margin: 20px;
                    min-width: 200px;
                }

                .fromtocontent {
                    margin: 10px;
                    margin-right: 15px;
                }

                .panel {
                    background-color: #afafaf;
                    padding: 7px;
                }

                .items {
                    clear: both;
                    display: table;
                    padding: 20px;
                }

                /* Factor out common styles for all of the "col-" classes.*/
                div[class^="col-"] {
                    display: table-cell;
                    padding: 7px;
                }

                /*for clarity name column styles by the percentage of width */
                .col-1-10 {
                    width: 10%;
                }

                .col-1-52 {
                    width: 52%;
                }

                .row {
                    display: table-row;
                    page-break-inside: avoid;
                }

        </style>
        </head>
        <table width="100%" style="border-collapse: collapse;padding: 5px;border: 0px solid #FFFFFF; font-size:14px;" id="company_address_data">
            <tr style="border-bottom: 1px solid  transparent;">
                <td width="25%" style="vertical-align: middle;text-align: center;">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" style="max-height: 100px;height: auto;"/>
                    <br/>
                </td>
                
                <td width="15%" align="center" valign="top">
                    <!--  -->
                </td>
                <td width="60%" align="right" valign="middle" style="padding-right:5px;">
                    <div class="fromto from" style="width: 90%;" >
                        <div class="panel" align="center" style="border-radius: 10px;">
                            <strong>
                                <span style="color: black; font-size:16px;" t-if="o.move_type == 'out_invoice'" >
                                    I - Factura - VERSIÓN 4.0
                                </span>
                                <span style="color: black; font-size:16px;" t-if="o.move_type == 'out_refund'" >
                                    E - Nota de Crédito - VERSIÓN 4.0
                                </span>
                            </strong>
                        </div>
                        
                        <div class="fromtocontent" style="font-size:12px;">
                            <div align="center">
                                <strong style="color: red;">
                                    <span t-field="o.name" />
                                </strong><br/>
                                <strong>
                                    Folio Fiscal (UUID)
                                </strong><br/>
                                <span t-out="cfdi_values.get('uuid')">No identificado</span><br/>
                                <strong>
                                    No. de serie del CSD del emisor
                                </strong><br/>
                                <span t-out="cfdi_values.get('certificate_number')">30001000000500003416</span><br/>
                                <strong>
                                    Fecha y Hora de emisión
                                </strong><br/>
                                <span t-out="cfdi_values.get('emission_date_str')">2023-09-12</span><br/>
                            </div>
                        </div>
                    </div>              
                    
                </td>
            </tr>
        </table>


    </div>
</template>


