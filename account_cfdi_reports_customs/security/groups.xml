<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_purchase_import_manager" model="res.groups">
        <field name="name">Purchase Import Administrator</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


    <data noupdate="0">

    <!-- Multi-company -->
    <record model="ir.rule" id="purchase_import_multicompany">
        <field name="name">Purchase Import  multi-company</field>
        <field name="model_id" ref="model_purchase_import"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    </data>
</odoo>
