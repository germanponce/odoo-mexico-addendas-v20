<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="model_account_move_action_relate" model="ir.actions.server">
            <field name="name">Relate Invoice to XML</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">records.relate_download()</field>
        </record>

        <record id="model_account_edi_downloaded_xml_sat_action_relate" model="ir.actions.server">
            <field name="name">Relate XML to Invoice</field>
            <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
            <field name="binding_model_id" ref="model_account_edi_downloaded_xml_sat"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">records.relate_download()</field>
        </record>

        <!-- Acción de servidor: Actualizar Lotes Importador XML SAT -->
        <record id="action_update_selected_batches" model="ir.actions.server">
            <field name="name">Actualizar Lotes Importador XML SAT</field>
            <field name="model_id" ref="model_account_edi_api_download"/>
            <field name="binding_model_id" ref="model_account_edi_api_download"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
if records:
    for batch in records:
        try:
            batch.action_download()
        except Exception as e:
            raise UserError(f"Error actualizando lote {batch.name}: {str(e)}")
            </field>
        </record>

        <!-- ================================================================ -->
        <!-- NUEVA ACCIÓN: Buscar Documentos Origen (NO AFECTA EXISTENTES) -->
        <!-- ================================================================ -->
        <record id="action_server_search_origin_documents" model="ir.actions.server">
            <field name="name">🔍 Buscar Documentos Origen</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="binding_model_id" ref="account.model_account_move_line"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = records.action_search_origin_document()
            </field>
        </record>
        
        <!-- Acción para XMLs Descargados -->
        <record id="action_server_search_origin_downloaded_xml" model="ir.actions.server">
            <field name="name">🔍 Buscar Documentos Origen</field>
            <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
            <field name="binding_model_id" ref="model_account_edi_downloaded_xml_sat"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = records.action_search_origin_document()
            </field>
        </record>
    </data>

</odoo>
