<?xml version="1.0" encoding="utf-8"?>
<!--
    Odoo 18 migration notes:
    - In Odoo 17/18 the invoice form `view_move_form` still has a label
      referencing `journal_id`.  The xpath below targets that label.
    - If the invoice form changes in future patches, try the alternative:
        expr="//field[@name='name']" position="before"
      and place the vendor_uuid field there instead.
-->
<odoo>

    <record model="ir.ui.view" id="l10n_mx_einvoice_portal_bills_inherit">
        <field name="name">account.move.form.portal.bill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='journal_id']" position="before">
                <field name="vendor_uuid"
                       invisible="not vendor_uuid"
                       readonly="1"
                       string="Folio Fiscal (Portal)"/>
            </xpath>
        </field>
    </record>

</odoo>
