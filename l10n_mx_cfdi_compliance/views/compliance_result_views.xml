<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_compliance_result_list" model="ir.ui.view">
        <field name="name">l10n_mx.compliance.result.list</field>
        <field name="model">l10n_mx.compliance.result</field>
        <field name="arch" type="xml">
            <list decoration-success="passed" decoration-danger="not passed and severity == 'error'"
                  decoration-warning="not passed and severity == 'warning'"
                  decoration-muted="overridden">
                <field name="document_id"/>
                <field name="rule_code"/>
                <field name="rule_name"/>
                <field name="severity"/>
                <field name="passed" widget="boolean_toggle"/>
                <field name="message"/>
                <field name="overridden"/>
                <field name="execution_ms"/>
            </list>
        </field>
    </record>

    <record id="view_compliance_result_form" model="ir.ui.view">
        <field name="name">l10n_mx.compliance.result.form</field>
        <field name="model">l10n_mx.compliance.result</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="document_id"/>
                            <field name="rule_id"/>
                            <field name="rule_category"/>
                            <field name="severity"/>
                            <field name="passed"/>
                            <field name="execution_ms"/>
                            <field name="score_impact"/>
                        </group>
                        <group string="Override">
                            <field name="overridden"/>
                            <field name="override_user_id"/>
                            <field name="override_date"/>
                            <field name="override_reason"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="details" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_compliance_results" model="ir.actions.act_window">
        <field name="name">Resultados de Compliance</field>
        <field name="res_model">l10n_mx.compliance.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
