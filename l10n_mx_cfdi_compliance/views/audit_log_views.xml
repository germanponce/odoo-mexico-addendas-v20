<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audit_log_list" model="ir.ui.view">
        <field name="name">l10n_mx.compliance.audit.log.list</field>
        <field name="model">l10n_mx.compliance.audit.log</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false"
                  decoration-danger="chain_broken">
                <field name="create_date"/>
                <field name="action"/>
                <field name="document_id"/>
                <field name="user_id"/>
                <field name="ip_address" optional="hide"/>
                <field name="hash_chain" optional="hide"/>
                <field name="chain_broken"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_audit_log_form" model="ir.ui.view">
        <field name="name">l10n_mx.compliance.audit.log.form</field>
        <field name="model">l10n_mx.compliance.audit.log</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="action"/>
                            <field name="document_id"/>
                            <field name="user_id"/>
                            <field name="ip_address"/>
                            <field name="company_id"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="prev_hash"/>
                            <field name="hash_chain"/>
                            <field name="chain_broken"/>
                        </group>
                    </group>
                    <group>
                        <field name="payload" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_audit_log" model="ir.actions.act_window">
        <field name="name">Bitacora de Auditoria</field>
        <field name="res_model">l10n_mx.compliance.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_audit_verify_chain_server" model="ir.actions.server">
        <field name="name">Verificar integridad de cadena</field>
        <field name="model_id" ref="model_l10n_mx_compliance_audit_log"/>
        <field name="state">code</field>
        <field name="code">action = model.action_verify_chain()</field>
    </record>
</odoo>
