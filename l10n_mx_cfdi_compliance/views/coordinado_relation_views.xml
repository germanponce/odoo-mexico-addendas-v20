<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coordinado_relation_list" model="ir.ui.view">
        <field name="name">l10n_mx.cfdi.coordinado.relation.list</field>
        <field name="model">l10n_mx.cfdi.coordinado.relation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="controladora_company_id"/>
                <field name="coordinada_vat"/>
                <field name="coordinada_company_id"/>
                <field name="relation_type"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="accept_cfdi_to_coordinada"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_coordinado_relation_form" model="ir.ui.view">
        <field name="name">l10n_mx.cfdi.coordinado.relation.form</field>
        <field name="model">l10n_mx.cfdi.coordinado.relation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Convenio Coordinados 2026..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="controladora_company_id"/>
                            <field name="coordinada_company_id"/>
                            <field name="coordinada_partner_id"/>
                            <field name="coordinada_vat"/>
                            <field name="relation_type"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="active"/>
                            <field name="accept_cfdi_to_coordinada"/>
                            <field name="require_distribution_record"/>
                            <field name="legal_document_attachment_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_coordinado_relations" model="ir.actions.act_window">
        <field name="name">Relaciones Coordinados</field>
        <field name="res_model">l10n_mx.cfdi.coordinado.relation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
