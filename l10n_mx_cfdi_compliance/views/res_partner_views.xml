<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_cfdi" model="ir.ui.view">
        <field name="name">res.partner.form.cfdi.compliance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="CFDI Compliance">
                    <field name="compliance_profile_id"/>
                    <field name="cfdi_compliance_score_avg"/>
                    <field name="cfdi_blocked_count"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
