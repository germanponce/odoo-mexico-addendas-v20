<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_inherit_cfdi" model="ir.ui.view">
        <field name="name">account.move.form.cfdi.compliance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="cfdi_compliance_state" widget="statusbar"
                       invisible="move_type not in ('in_invoice','in_refund') or not cfdi_document_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="CFDI Compliance" invisible="move_type not in ('in_invoice','in_refund')">
                    <group>
                        <group>
                            <field name="cfdi_document_id"/>
                            <field name="cfdi_compliance_state"/>
                            <field name="cfdi_compliance_score" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="compliance_profile_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_list_inherit_cfdi" model="ir.ui.view">
        <field name="name">account.move.list.cfdi.compliance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total_in_currency_signed" position="after">
                <field name="cfdi_compliance_state" optional="show"/>
                <field name="cfdi_compliance_score" optional="hide" widget="progressbar"/>
            </field>
        </field>
    </record>
</odoo>
