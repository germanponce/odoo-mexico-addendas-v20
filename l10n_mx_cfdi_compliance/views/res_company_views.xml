<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_cfdi" model="ir.ui.view">
        <field name="name">res.company.form.cfdi.compliance</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="CFDI Compliance Engine (ANFEPI)">
                    <group>
                        <field name="default_compliance_profile_id"/>
                        <field name="is_coordinados_controladora"/>
                    </group>
                    <group>
                        <field name="cfdi_compliance_async_threshold_kb"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
