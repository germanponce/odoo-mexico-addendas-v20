<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_audit_chain_verify" model="ir.cron">
            <field name="name">CFDI Compliance: verify audit chain integrity</field>
            <field name="model_id" ref="model_l10n_mx_compliance_audit_log"/>
            <field name="state">code</field>
            <field name="code">model.action_verify_chain()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_sync_rule_catalog" model="ir.cron">
            <field name="name">CFDI Compliance: sync rule catalog from registry</field>
            <field name="model_id" ref="model_l10n_mx_compliance_rule"/>
            <field name="state">code</field>
            <field name="code">model._sync_from_registry()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cola persistente del pipeline (reemplazo de threading.Thread).
             Procesa hasta `queue_batch_size` (default 20) jobs pending por
             ciclo. FOR UPDATE SKIP LOCKED garantiza concurrencia segura
             incluso si el cron corre en multiples workers simultaneamente. -->
        <record id="cron_process_pipeline_queue" model="ir.cron">
            <field name="name">CFDI Compliance: process pipeline job queue</field>
            <field name="model_id" ref="model_l10n_mx_cfdi_pipeline_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pending()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
