<odoo>
    <data>

        <record model="ir.ui.view" id="addenda_fresko_amc_71_sale_fields_form">
            <field name="name">addenda_fresko_amc_71_sale_fields_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.sale_order_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="fresko_amc" string="Addenda Fresko AMC 7.1" 
                        invisible="addenda_type != 'fresko_amc'">
                        <group>
                            <field name="l10n_mx_edi_amece_referenceidentification"/>
                            <field name="l10n_mx_edi_amece_referencedate"/>
                            <field name="l10n_mx_edi_amece_additionalinformation"/>
                        </group>
                        <group>
                            <field name="l10n_mx_edi_amece_personordepartmentname"/>
                            <field name="l10n_mx_edi_amece_shipto_id"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="addenda_fresko_amc_71_invoice_fields_form">
            <field name="name">addenda_fresko_amc_71_invoice_fields_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.account_move_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="fresko_amc" string="Addenda Fresko AMC 7.1" invisible="addenda_type != 'fresko_amc'">
                        <group>
                            <field name="l10n_mx_edi_amece_referenceidentification"/>
                            <field name="l10n_mx_edi_amece_referencedate"/>
                            <field name="l10n_mx_edi_amece_additionalinformation"/>
                        </group>
                        <group>
                            <field name="l10n_mx_edi_amece_personordepartmentname"/>
                            <field name="l10n_mx_edi_amece_shipto_id"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>



    </data>
</odoo>