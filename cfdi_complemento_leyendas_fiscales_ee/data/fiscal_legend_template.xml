<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="fiscal_legend_template_40" inherit_id="l10n_mx_edi.cfdiv40">
        <xpath expr="//*[name()='cfdi:Comprobante']" position="attributes">
            <t t-if="complemento_leyendas_fiscales and leyendas_fiscales_ids" xmlns:cfdi="http://www.sat.gob.mx/cfd/4"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                <attribute name="xmlns:leyendasFisc" t-value="'http://www.sat.gob.mx/leyendasFiscales'"/>
                <attribute name="xsi:schemaLocation" t-value="'http://www.sat.gob.mx/cfd/4 http://www.sat.gob.mx/sitio_internet/cfd/4/cfdv40.xsd http://www.sat.gob.mx/leyendasFiscales http://www.sat.gob.mx/sitio_internet/cfd/leyendasFiscales/leyendasFisc.xsd'"/>
            </t>
        </xpath>

        <xpath expr="*" position="inside">
            <t t-if="complemento_leyendas_fiscales and leyendas_fiscales_ids">
                <cfdi:Complemento
                    xmlns:cfdi="http://www.sat.gob.mx/cfd/4"
                    xmlns:leyendasFisc="http://www.sat.gob.mx/leyendasFiscales">
                    <leyendasFisc:LeyendasFiscales version="1.0">
                        <t t-foreach="leyendas_fiscales_ids" t-as="leyenda">
                          <leyendasFisc:Leyenda t-att-disposicionFiscal="leyenda.disposicion" t-att-norma="leyenda.norma" t-att-textoLeyenda="leyenda.texto_leyenda"/>
                        </t>
                    </leyendasFisc:LeyendasFiscales>
                </cfdi:Complemento>
            </t>
        </xpath>
    </template>

</odoo>
