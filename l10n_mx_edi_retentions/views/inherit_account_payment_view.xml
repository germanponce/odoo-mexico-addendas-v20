<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="b_inherit_view_account_payment_form" model="ir.ui.view">
            <field name="name">b.inherit.view.account.payment.form.retentions</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">

                <xpath expr="//group[@name='group2']" position="inside">
                    <field name="require_retention_cfdi" widget="boolean_toggle"/>
                    <field name="retention_type_id"
                           invisible="not require_retention_cfdi"
                           required="require_retention_cfdi"
                           readonly="l10n_mx_edi_retention_uuid"
                           options="{'no_create': False}"/>
                    <field name="l10n_mx_edi_ret_ext_tipo_contribuyente_id"
                           invisible="not require_retention_cfdi"
                           required="require_retention_cfdi"
                           readonly="l10n_mx_edi_retention_uuid"
                           options="{'no_create': False}"/>
                    <field name="l10n_mx_edi_retention_is_foreign"
                           invisible="not require_retention_cfdi"
                           readonly="l10n_mx_edi_retention_uuid"
                           widget="boolean_toggle"/>
                    <field name="l10n_mx_edi_retention_state"
                           invisible="not require_retention_cfdi"
                           widget="statusbar"
                           statusbar_visible="draft,sent,error"/>
                    <field name="l10n_mx_edi_retention_uuid"
                           invisible="not require_retention_cfdi or l10n_mx_edi_retention_state != 'sent'"
                           readonly="1"/>
                    <field name="l10n_mx_edi_retention_error_message"
                           invisible="not require_retention_cfdi or l10n_mx_edi_retention_state != 'error'"
                           readonly="1" widget="text"/>
                </xpath>

                <!-- ── Botones smart ───────────────────────────────────── -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_prefill_retention_from_bills" type="object"
                            string="Pre-llenar desde Facturas" class="oe_stat_button"
                            icon="fa-magic"
                            invisible="not require_retention_cfdi or l10n_mx_edi_retention_state == 'sent'"
                            title="Extrae automáticamente los montos e impuestos de retención desde las facturas conciliadas con este pago."/>
                    <button name="action_l10n_mx_edi_retention_try_send" type="object"
                            string="Timbrar" class="oe_stat_button" icon="fa-file-text-o"
                            invisible="not require_retention_cfdi or l10n_mx_edi_retention_state == 'sent'"/>
                    <button name="action_download_retention_xml" type="object"
                            string="XML Retención" class="oe_stat_button" icon="fa-download"
                            invisible="not require_retention_cfdi or l10n_mx_edi_retention_state != 'sent'"/>
                    <button name="action_l10n_mx_edi_retention_reset" type="object"
                            string="Reintentar" class="oe_stat_button" icon="fa-refresh"
                            invisible="not require_retention_cfdi or l10n_mx_edi_retention_state != 'error'"/>

                    <button name="action_download_pre_stamp_xml" type="object"
                            string="XML Pre-Stamp" class="oe_stat_button" icon="fa-bug"
                            invisible="not require_retention_cfdi or not l10n_mx_edi_retention_pre_stamp_id"
                            title="Descargar el XML enviado al PAC (antes de timbrarse). Útil para depurar errores."/>
                </xpath>

                <!-- ── Sección CFDI Retenciones ──────────────────────── -->
                <xpath expr="//sheet" position="inside">
                    <div invisible="not require_retention_cfdi" class="mt-3">
                        <notebook>

                            <!-- ─ Tab: Datos Generales ──────────────── -->
                            <page string="Retención CFDI" name="retention_data">

                                <group string="Período Fiscal">
                                    <group>
                                        <field name="l10n_mx_edi_retention_mes_ini"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_retention_mes_fin"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_retention_ejercicio"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                </group>

                                <group string="Totales (nodo Totales v2.0)">
                                    <group>
                                        <field name="l10n_mx_edi_retention_monto_tot_operacion"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_retention_monto_tot_grav"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group>
                                        <field name="l10n_mx_edi_retention_monto_tot_exent"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_retention_monto_tot_ret" readonly="1"/>
                                    </group>
                                </group>

                                <field name="l10n_mx_edi_retention_impuesto_ids"
                                       string="Impuestos Retenidos (ImpRetenidos)"
                                       readonly="l10n_mx_edi_retention_uuid">
                                    <list editable="bottom">
                                        <field name="impuesto_ret" required="1"/>
                                        <field name="base_ret" required="1"/>
                                        <field name="monto_ret" required="1"/>
                                        <field name="tipo_pago_ret" required="1"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>

                            </page>

                            <!-- ─ Tab: Complemento ──────────────────── -->
                            <page string="Complemento" name="retention_complement">

                                <group>
                                    <field name="l10n_mx_edi_retention_complement"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                </group>

                                <!-- Relacionados -->
                                <group string="CFDI Relacionado"
                                       invisible="l10n_mx_edi_retention_complement != 'relacionados'">
                                    <field name="l10n_mx_edi_ret_rel_tipo"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_rel_uuid"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                </group>

                                <!-- Pagos a Extranjeros -->
                                <group string="Pagos a Extranjeros"
                                       invisible="l10n_mx_edi_retention_complement != 'pagosaextranjeros'">
                                    <field name="l10n_mx_edi_ret_ext_es_benef"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_ext_pais_id"
                                           invisible="l10n_mx_edi_ret_ext_es_benef == 'SI'"
                                           options="{'no_create': True}"
                                           required="l10n_mx_edi_retention_complement == 'pagosaextranjeros'"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_ext_pais"
                                           invisible="l10n_mx_edi_ret_ext_es_benef == 'SI'"
                                           force_save="1"
                                           readonly="1"/>
                                    <field name="l10n_mx_edi_ret_ext_descripcion"
                                           invisible="l10n_mx_edi_ret_ext_es_benef == 'SI'"
                                           required="l10n_mx_edi_retention_complement == 'pagosaextranjeros'"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_ext_concepto_pago"
                                           required="l10n_mx_edi_retention_complement == 'pagosaextranjeros'"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_ext_rfc_benef"
                                           invisible="l10n_mx_edi_ret_ext_es_benef != 'SI'"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_ext_curp_benef"
                                           invisible="l10n_mx_edi_ret_ext_es_benef != 'SI'"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_ext_nom_benef"
                                           invisible="l10n_mx_edi_ret_ext_es_benef != 'SI'"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                </group>

                                <!-- Dividendos -->
                                <group string="Dividendos"
                                       invisible="l10n_mx_edi_retention_complement != 'dividendos'">
                                    <group>
                                        <field name="l10n_mx_edi_ret_div_cve_tipo"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_div_tipo_soc"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group>
                                        <field name="l10n_mx_edi_ret_div_isr_mexico"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_div_isr_extran"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_div_isr_nal"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_div_acum_nal"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                </group>

                                <!-- Enajenación de Acciones -->
                                <group string="Enajenación de Acciones"
                                       invisible="l10n_mx_edi_retention_complement != 'enajenaciondeacciones'">
                                    <field name="l10n_mx_edi_ret_acc_contrato"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_acc_ganancia"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_acc_perdida"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                </group>

                                <!-- Fideicomisos No Empresariales -->
                                <group string="Fideicomisos No Empresariales"
                                       invisible="l10n_mx_edi_retention_complement != 'fideicomisonoempresarial'">
                                    <group string="Ingresos/Entradas">
                                        <field name="l10n_mx_edi_ret_fide_prop_ing"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_fide_part_ing"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_fide_entradas"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_fide_concepto_ing"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group string="Salidas/Egresos">
                                        <field name="l10n_mx_edi_ret_fide_prop_sal"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_fide_part_sal"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_fide_egresos"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_fide_concepto_sal"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group string="Retención">
                                        <field name="l10n_mx_edi_ret_fide_desc_ret"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_fide_monto_ret"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                </group>

                                <!-- Intereses -->
                                <group string="Intereses"
                                       invisible="l10n_mx_edi_retention_complement != 'intereses'">
                                    <group>
                                        <field name="l10n_mx_edi_ret_int_sist"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_int_ores"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_int_oper"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group>
                                        <field name="l10n_mx_edi_ret_int_nominal"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_int_real"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_int_perdida"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                </group>

                                <!-- Intereses Hipotecarios -->
                                <group string="Intereses Hipotecarios"
                                       invisible="l10n_mx_edi_retention_complement != 'intereseshipotecarios'">
                                    <group>
                                        <field name="l10n_mx_edi_ret_hip_credito"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_hip_num_contrato"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_hip_saldo"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_hip_prop_deduc"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group>
                                        <field name="l10n_mx_edi_ret_hip_int_nom"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_hip_int_nom_pag"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_hip_int_real"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                </group>

                                <!-- Operaciones Con Derivados -->
                                <group string="Operaciones Con Derivados"
                                       invisible="l10n_mx_edi_retention_complement != 'operacionesconderivados'">
                                    <field name="l10n_mx_edi_ret_der_ganancia"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_der_perdida"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                </group>

                                <!-- Planes de Retiro -->
                                <group string="Planes de Retiro"
                                       invisible="l10n_mx_edi_retention_complement != 'planesderetiro'">
                                    <group string="Datos Generales">
                                        <field name="l10n_mx_edi_ret_plan_sist"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_num_ref"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_aport"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_int"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_excedente"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group string="Retiros">
                                        <field name="l10n_mx_edi_ret_plan_retiros_per"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_monto_ret_per"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_retiros"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_monto_ret"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_exento"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group string="Aportación/Depósito">
                                        <field name="l10n_mx_edi_ret_plan_tipo_ap"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_monto_dep"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plan_rfc_fiduc"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                </group>

                                <!-- Plataformas Tecnológicas -->
                                <group string="Plataformas Tecnológicas"
                                       invisible="l10n_mx_edi_retention_complement != 'plataformastecnologicas'">
                                    <group string="Totales de Servicios">
                                        <field name="l10n_mx_edi_ret_plat_period"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_num_serv"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_monto_sin_iva"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_iva_tras"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_iva_ret"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_isr_ret"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_dif_iva"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_uso"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group string="Detalle del Servicio">
                                        <field name="l10n_mx_edi_ret_plat_forma_pago"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_tipo_serv"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_fecha_serv"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_precio"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_importe_iva"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_plat_comision"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                </group>

                                <!-- Premios -->
                                <group string="Premios"
                                       invisible="l10n_mx_edi_retention_complement != 'premios'">
                                    <field name="l10n_mx_edi_ret_prem_entidad"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_prem_monto"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_prem_grav"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_prem_exent"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                </group>

                                <!-- Sector Financiero -->
                                <group string="Sector Financiero"
                                       invisible="l10n_mx_edi_retention_complement != 'sectorfinanciero'">
                                    <field name="l10n_mx_edi_ret_sec_descrip"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_sec_id"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                    <field name="l10n_mx_edi_ret_sec_nom"
                                           readonly="l10n_mx_edi_retention_uuid"/>
                                </group>

                                <!-- Arrendamiento en Fideicomiso -->
                                <group string="Arrendamiento en Fideicomiso"
                                       invisible="l10n_mx_edi_retention_complement != 'arrendamientoenfideicomiso'">
                                    <group>
                                        <field name="l10n_mx_edi_ret_arren_pag_prov"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_arren_rendim"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_arren_deduc"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_arren_tot_ret"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                    <group>
                                        <field name="l10n_mx_edi_ret_arren_res_fis"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_arren_otros"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                        <field name="l10n_mx_edi_ret_arren_desc_otros"
                                               readonly="l10n_mx_edi_retention_uuid"/>
                                    </group>
                                </group>

                            </page>
                        </notebook>
                    </div>
                </xpath>

            </field>
        </record>

        <!-- ── Vista lista  Pagos -  Proveedor ────────────────────────────────────────── -->
        <record id="b_inherit_view_account_payment_tree" model="ir.ui.view">
            <field name="name">b.inherit.view.account.payment.tree.retentions</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="l10n_mx_edi_retention_state"
                           optional="show"
                           invisible="not require_retention_cfdi"
                           string="Estado Ret. CFDI"/>
                </xpath>
            </field>
        </record>
        

    </data>
</odoo>
