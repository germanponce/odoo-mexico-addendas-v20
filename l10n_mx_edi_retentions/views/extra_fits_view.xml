<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
                
        <!-- Tipos de Retencion -->

        <record id="sat_retention_type_tree" model="ir.ui.view">
            <field name="name">retention.type.tree</field>
            <field name="model">retention.type</field>
            <field name="arch" type="xml">
                <list string="Tipos de Retencion SAT" >
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="sat_retention_type_form" model="ir.ui.view">
            <field name="name">retention.type.form</field>
            <field name="model">retention.type</field>
            <field name="arch" type="xml">
                <form string="Tipo de Retencion SAT">
                    <sheet>
                         <div class="oe_title">
                        <label class="oe_edit_only" for="code" string="Codigo SAT"/>
                        <h1><field name="code" placeholder="10101501"/></h1>
                        
                    </div>

                        
                        <group >
                            <field name="name" />
                        </group>
                        <group>
                            <group>

                            </group>
                            <group>
                            </group>
                        </group>
                        
                    </sheet>
                    
                </form>
            </field>
        </record>


        <record id="sat_retention_type_search" model="ir.ui.view">
            <field name="name">retention.type.serch</field>
            <field name="model">retention.type</field>
            <field name="arch" type="xml">
                <search string="Tipos de Retencion">

                    <field name="code"/>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="action_retention_types_pago" model="ir.actions.act_window">
            <field name="name">Tipos de Retencion</field>
            <field name="res_model">retention.type</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="sat_retention_type_tree"/>
        </record>

       
        <!--  Tipo Contribuyente SujetoRetencion -->

        <record id="sat_retention_type_taxpayer_tree" model="ir.ui.view">
            <field name="name">retention.type.taxpayer.tree</field>
            <field name="model">retention.type.taxpayer</field>
            <field name="arch" type="xml">
                <list string="Tipos de Contribuyentes Sujetos a Retencion" >
                    <field name="code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="sat_retention_type_taxpayer_form" model="ir.ui.view">
            <field name="name">retention.type.taxpayer.form</field>
            <field name="model">retention.type.taxpayer</field>
            <field name="arch" type="xml">
                <form string="Tipo Contribuyente Sujeto Retencion">
                    <sheet>
                         <div class="oe_title">
                        <label class="oe_edit_only" for="code" string="Codigo SAT"/>
                        <h1><field name="code" placeholder="10101501"/></h1>
                        
                    </div>

                        
                        <group >
                            <field name="name" />
                        </group>
                        <group>
                            <group>

                            </group>
                            <group>
                            </group>
                        </group>
                        
                    </sheet>
                    
                </form>
            </field>
        </record>


        <record id="sat_retention_type_taxpayer_search" model="ir.ui.view">
            <field name="name">retention.type.taxpayer.serch</field>
            <field name="model">retention.type.taxpayer</field>
            <field name="arch" type="xml">
                <search string="Contribuyente Sujeto Retencion">
                    <field name="code"/>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="action_retention_type_taxpayer_pago" model="ir.actions.act_window">
            <field name="name">Tipo Contribuyente Sujeto Retencion</field>
            <field name="res_model">retention.type.taxpayer</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="sat_retention_type_taxpayer_tree"/>
        </record>

    </data>
</odoo>
