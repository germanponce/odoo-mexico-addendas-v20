            </p>
        </field>
    </record>

    <!-- ============================================================
         MENU ITEMS (debajo de "Reporte de Conciliacion")
         Definidos aqui (no en views/l10n_mx_edi_view.xml) para
         garantizar orden de carga: la action se carga antes del menuitem.
         ============================================================ -->

    <menuitem id="menu_complemento_pago_cliente"
              parent="l10n_mx_xml_massive_download.menu_l10n_mx_xml_sat"
              action="action_complemento_pago_cliente_report"
              sequence="4"
              name="Complemento Pago Clientes"
              groups="l10n_mx_xml_massive_download.group_l10n_mx_xml_sat_user"/>

    <menuitem id="menu_complemento_pago_proveedor"
              parent="l10n_mx_xml_massive_download.menu_l10n_mx_xml_sat"
              action="action_complemento_pago_proveedor_report"
              sequence="5"
              name="Complemento Pago Proveedores"
              groups="l10n_mx_xml_massive_download.group_l10n_mx_xml_sat_user"/>

</odoo>
