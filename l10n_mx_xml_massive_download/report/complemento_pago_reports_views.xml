    <record id="action_complemento_pago_proveedor_report" model="ir.actions.act_window">
        <field name="name">Complemento Pago Proveedores</field>
        <field name="res_model">l10n_mx.complemento.pago.proveedor.report</field>
        <field name="view_mode">list</field>
