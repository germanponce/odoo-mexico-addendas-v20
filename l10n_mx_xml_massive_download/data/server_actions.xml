<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================================================
         CONVENCION DE VISIBILIDAD
         =========================================================================
         Las acciones de "workflow normal" (revisar 69-B, buscar factura) quedan
         visibles a todos los usuarios con acceso al modulo. Las acciones de
         REMEDIACION / MIGRACION / MANTENIMIENTO solo se muestran a usuarios
         con grupo Administracion (base.group_system) — el menu Acciones las
         oculta automaticamente para usuarios sin ese grupo.

         Si por alguna razon el campo groups_id no aplica en server actions de
         tu version Odoo, el primer check del code lanza UserError, garantizando
         doble proteccion: visibilidad UI + bloqueo en ejecucion.
         ========================================================================= -->

    <!-- ====== VISIBLES PARA TODOS ====== -->

    <!-- Revisión Art 69-B para XML seleccionados -->
    <record id="action_review_69b_selected_xml" model="ir.actions.server">
        <field name="name">Revisar Art 69-B (seleccionados)</field>
        <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
        <field name="binding_model_id" ref="model_account_edi_downloaded_xml_sat"/>
        <field name="state">code</field>
        <field name="code">action = records.action_review_69b()</field>
        <field name="binding_type">action</field>
    </record>

    <!-- Buscar y relacionar Factura Relacionada para XML seleccionados -->
    <record id="action_search_related_invoice_selected_xml" model="ir.actions.server">
