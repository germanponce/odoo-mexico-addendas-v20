    <!-- Re-aplicar IEPS-en-base retroactivamente sobre facturas en borrador
         creadas desde XMLs seleccionados (admin only). -->
    <record id="action_apply_ieps_in_base_retroactive" model="ir.actions.server">
        <field name="name">Aplicar IEPS en la Base retroactivo (admin)</field>
        <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
        <field name="binding_model_id" ref="model_account_edi_downloaded_xml_sat"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
if not env.user.has_group('base.group_system'):
    raise UserError(_('Esta accion solo esta disponible para Administradores.'))
action = records.action_apply_ieps_in_base_retroactive()
        </field>
