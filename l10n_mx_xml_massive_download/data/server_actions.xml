    </record>

    <!-- Backfill xml.sat para REPs timbrados sin entrada en SAT (admin).
         Crea registros account.edi.downloaded.xml.sat usando el lote real
         del mes correspondiente. Idempotente: skipea UUIDs ya existentes
         y moves sin lote del mes. Procesa hasta 500 por invocacion. -->
    <record id="action_backfill_xml_sat_from_payments" model="ir.actions.server">
        <field name="name">Backfill xml.sat desde Payments timbrados (admin)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
if not env.user.has_group('base.group_system'):
    raise UserError(_('Esta accion solo esta disponible para Administradores.'))
result = env['account.move'].action_backfill_xml_sat_from_payments(limit=500)
raise UserError(
    'Backfill xml.sat\n\nMoves escaneados: %s\nCreados: %s\nSkipped: %s\nErrores: %s\n\n'
    'Si Creados > 0, vuelve a ejecutar hasta que Creados=0 (procesa lotes de 500).' % (
        result['scanned'], result['created'], result['skipped'], result['errors'],
    )
)
        </field>
    </record>

    <!-- Backfill xml.sat para Facturas timbradas sin entrada en SAT (admin).
         Analogo al de payments pero para account.move tipo factura
         (out_invoice, in_invoice, out_refund, in_refund). Resuelve los
         rojos "Factura no localizada en XML SAT" cuando el backend xmlsat
         no descargo la factura aunque exista timbrada y validada en Odoo. -->
    <record id="action_backfill_xml_sat_from_invoices" model="ir.actions.server">
        <field name="name">Backfill xml.sat desde Facturas timbradas (admin)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
if not env.user.has_group('base.group_system'):
    raise UserError(_('Esta accion solo esta disponible para Administradores.'))
result = env['account.move'].action_backfill_xml_sat_from_invoices(limit=500)
raise UserError(
    'Backfill xml.sat (Facturas)\n\nMoves escaneados: %s\nCreados: %s\nSkipped: %s\nErrores: %s\n\n'
    'Si Creados > 0, vuelve a ejecutar hasta que Creados=0 (procesa lotes de 500).' % (
        result['scanned'], result['created'], result['skipped'], result['errors'],
    )
)
        </field>
    </record>

    <!-- ====== ELIMINACION DE LOTES (solo admin) ====== -->

    <!-- Eliminar lote y todos sus XMLs hijos: SOLO ADMIN. Util cuando un lote
         se creo por error, o cuando se quiere limpiar duplicados. CASCADA: borra
         account.edi.downloaded.xml.sat y account.edi.downloaded.xml.sat.products. -->
    <record id="action_admin_delete_batch" model="ir.actions.server">
        <field name="name">⚠️ Eliminar Lote y sus XMLs (admin)</field>
        <field name="model_id" ref="model_account_edi_api_download"/>
        <field name="binding_model_id" ref="model_account_edi_api_download"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
if not env.user.has_group('base.group_system'):
    raise UserError(_('Esta accion solo esta disponible para Administradores.'))
action = records.action_admin_delete_batch()
        </field>
        <field name="binding_type">action</field>
    </record>
</odoo>
