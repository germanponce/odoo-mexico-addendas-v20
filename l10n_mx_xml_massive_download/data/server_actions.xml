        <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
        <field name="binding_model_id" ref="model_account_edi_downloaded_xml_sat"/>
        <field name="state">code</field>
        <field name="code">action = records.action_search_related_invoice()</field>
        <field name="binding_type">action</field>
    </record>

    <!-- ====== SOLO ADMINISTRACION (base.group_system) ====== -->

    <!-- Recalcular currency_id para XML seleccionados (remediacion) -->
    <record id="action_recompute_currency_selected_xml" model="ir.actions.server">
        <field name="name">🔄 Recalcular Moneda (admin)</field>
        <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
        <field name="binding_model_id" ref="model_account_edi_downloaded_xml_sat"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
if not env.user.has_group('base.group_system'):
    raise UserError(_('Esta accion solo esta disponible para Administradores.'))
for record in records:
    record._compute_currency_id()
        </field>
        <field name="binding_type">action</field>
    </record>

