<?xml version="1.0" ?>
<odoo>
    <!-- noupdate=1: los crones ya existen tras el primer install; en upgrades
         NO se re-escriben. Esto (a) respeta ajustes de horario hechos por el
         admin y (b) permite actualizar el modulo EN CALIENTE sin chocar con un
         cron en ejecucion (antes el -u intentaba modificar el cron corriendo y
         fallaba con ParseError "cron being modified"). -->
    <data noupdate="1">

        <!-- Cron: actualiza el estatus SAT de los XMLs consultando el WS del SAT.
             Ejecuta cada 15 minutos con batch_size=200. Tras un cambio que activo
             el drenaje de huerfanos (sat_last_sync IS NULL), tarda ~8 dias en
             drenar 150K records (200 x 96 ejec/dia = 19,200/dia). Cuando no hay
             pendientes, el cron sale rapido y no impacta. Para drenar masivo en
             1 corrida, usar accion manual 'Re-consultar Estatus SAT (forzar)'. -->
        <record id="ir_cron_update_sat_state" model="ir.cron">
            <field name="name">Actualización automatica de estado sat</field>
            <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
            <field name="state">code</field>
            <field name="code">
env['account.edi.downloaded.xml.sat'].cron_fetch_sat_status(batch_size=200)
            </field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <!-- En Odoo 19 numbercall fue removido del modelo ir.cron; los
                 crons corren indefinidamente por diseno. En Odoo <=18 se
                 maneja via post-migrate (UPDATE numbercall=-1). -->
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:00')"/>
        </record>

        <record id="ir_cron_update_art69b_status" model="ir.cron">
            <field name="name">Actualización automática Art 69-B</field>
            <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
            <field name="state">code</field>
            <field name="code">
date_limit = (datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')
xmls = model.search([
    ('cfdi_type', '=', 'recibidos'),
    ('document_date', '&gt;=', date_limit)
])
if xmls:
    updated, not_found = xmls._update_69b_statuses()
    _logger.info('Art 69-B: Procesados %s XMLs - Actualizados: %s, No encontrados: %s', len(xmls), updated, not_found)
else:
    _logger.info('Art 69-B: No se encontraron XMLs recibidos desde %s', date_limit)
            </field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=7)).strftime('%Y-%m-%d 04:00:00')"/>
        </record>

        <!-- Cron: procesa lotes encolados ('queued') y re-sincroniza lotes no estables.
             Corre cada 2 minutos para que el usuario vea avance pronto despues de
             encolar desde la UI. Lotes ya estables (sync_stable=True) se omiten. -->
        <record id="ir_cron_auto_sync_batches" model="ir.cron">
            <field name="name">Auto-sync lotes SAT (procesa cola + re-sync)</field>
            <field name="model_id" ref="model_account_edi_api_download"/>
            <field name="state">code</field>
            <field name="code">
env['account.edi.api.download'].cron_auto_sync_batches()
            </field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=2)).strftime('%Y-%m-%d %H:%M:00')"/>
        </record>

        <!-- Cron: drena XMLs huerfanos sin cfdi_document (batch_size=200 cada
             15 min, ~19K XMLs/dia). Usa SQL LEFT JOIN para detectar pendientes,
             escala a 500K+. Skip automatico si compliance no instalado.
             Activo por default - cuando ya no haya pendientes solo logea y sale. -->
        <record id="ir_cron_evaluate_compliance_pending" model="ir.cron">
            <field name="name">Compliance: evaluar XMLs huerfanos (background)</field>
            <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
            <field name="state">code</field>
            <field name="code">
env['account.edi.downloaded.xml.sat'].cron_evaluate_compliance_pending(batch_size=200)
            </field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:00')"/>
        </record>
     
        <!-- Cron: refresca sat_metadata_ref desde xmlsat (/get-metadata) para los
             lotes recientes. Es la mitad Odoo del refresco de metadata (xmlsat tiene
             su cron que re-descarga la metadata del SAT). Diario 6am (tras el de
             xmlsat ~4:30am). Asi "CFDIs en SAT" en el tablero siempre es el total
             real y actual del SAT, no una foto vieja. -->
        <record id="ir_cron_refresh_sat_metadata" model="ir.cron">
            <field name="name">Refrescar metadata SAT (CFDIs en SAT)</field>
            <field name="model_id" ref="model_account_edi_api_download"/>
            <field name="state">code</field>
            <field name="code">
env['account.edi.api.download'].cron_refresh_sat_metadata()
            </field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now().replace(hour=6, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:00')"/>
        </record>

        <!-- Cron #B: DESACTIVADO por diseno (.48.5). Los campos que llena (fecha_timbrado,
             impuestos, cuenta predial, moneda) son ESTATICOS del XML y ya se pueblan de
             forma ROBUSTA AL CARGAR (el parse del pipeline tolera XMLs mal formados desde
             .47.4: reemplazo xmlns:schemaLocation -> xsi:schemaLocation). Re-checar campos
             estaticos cada 15 min es trabajo innecesario. Lo recurrente debe ser solo lo
             que CAMBIA con el tiempo (vigencia SAT, Art 69-B, relacionados), que tienen su
             propio cron. Para una limpieza puntual de registros historicos existe la accion
             manual de servidor "Backfill Fecha de Timbrado e Impuestos" (action_backfill_timbrado_y_taxes).
             Se deja el record (no se borra) por si se quiere reactivar; en installs existentes
             lo desactiva el post-migrate 19.0.48.5. -->
        <record id="ir_cron_backfill_xml_fields" model="ir.cron">
            <field name="name">Auto-poblar campos de XML SAT (fecha timbrado, impuestos, predial, moneda)</field>
            <field name="model_id" ref="model_account_edi_downloaded_xml_sat"/>
            <field name="state">code</field>
            <field name="code">
env['account.edi.downloaded.xml.sat'].cron_backfill_xml_fields()
            </field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:00')"/>
        </record>

    </data>
</odoo>
