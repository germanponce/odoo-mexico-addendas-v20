<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Wizard "Adjuntar XML": subir archivo o elegir XML descargado del SAT -->
    <record id="view_xml_upload_wizard_form" model="ir.ui.view">
        <field name="name">xml.upload.wizard.form</field>
        <field name="model">xml.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjuntar XML">
                <sheet>
                    <group>
                        <group string="Archivo XML">
                            <field name="file_name" invisible="1"/>
                            <field name="file" filename="file_name" placeholder="Sube tu archivo"/>
                        </group>
                        <group string="Downloaded Xmls">
                            <field name="downloaded_xmls" placeholder="Seleccionar XML de Odoo"/>
                        </group>
                    </group>
                    <separator/>
                    <p>Nota: Solo puede seleccionar un archivo o elegir uno de Odoo.</p>
                </sheet>
                <footer>
                    <button string="Subir" type="object" name="action_submit" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Confirmacion cuando hay discrepancias no bloqueantes (subtotal) -->
    <record id="view_custom_validation_confirm_form" model="ir.ui.view">
        <field name="name">custom.validation.confirm.form</field>
        <field name="model">custom.validation.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirmar Validacion">
                <h4>Se encontraron discrepancias:</h4>
                <field name="errors" nolabel="1" readonly="1"/>
                <p>¿Desea continuar a pesar de las diferencias?</p>
                <footer>
                    <button name="action_cancel" string="Cancelar" type="object" class="btn-secondary"/>
                    <button name="action_confirm" string="Continuar" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
