<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_factoring_res_partner_form" model="ir.ui.view">
            <field name="name">account_factoring_res_partner_form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='fiscal_information']" position="inside">
                    <field name="x_is_factoring_partner"/>
                    <field name="x_factoring_partner_id"
                           domain="[('x_is_factoring_partner','=',True)]"
                           options="{'no_create': True}"
                           invisible="not x_is_factoring_partner"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
