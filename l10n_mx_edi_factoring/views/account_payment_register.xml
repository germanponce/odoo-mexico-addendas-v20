<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_factoring_payment_register_form" model="ir.ui.view">
            <field name="name">account_factoring_payment_register_form</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <!-- Agregar el campo de factorante después de la cuenta bancaria -->
                <xpath expr="//field[@name='partner_bank_id']" position="after">
                    <field name="x_factoring_partner_id"
                           options="{'no_create': True}"
                           string="Factorante financiero"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
