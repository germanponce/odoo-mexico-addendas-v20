<odoo>
    <data>

        <record model="ir.ui.view" id="addenda_kontender_bovedafiscal_product_fields_form">
            <field name="name">addenda_kontender_bovedafiscal_product_fields_form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.product_template_only_form_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="bovadd" string="Addenda Tony BOVEDAFISCAL">
                        <group>
                            <field name="x_tony_code" />
                        </group>
                        <group>
                        </group>
                    </group>
                    
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="addenda_kontender_bovedafiscal_71_sale_fields_form">
            <field name="name">addenda_kontender_bovedafiscal_71_sale_fields_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.sale_order_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="amece" string="Addenda Tony BOVEDAFISCAL" 
                        invisible="addenda_type != 'bovadd'" >
                        <group>
                            <field name="l10n_mx_edi_addenda_bovedafiscal_no_pedido"/>
                            <field name="l10n_mx_edi_addenda_bovedafiscal_peso"/>
                        </group>
                        <group>
                            <field name="l10n_mx_edi_addenda_bovedafiscal_cantidad_bultos"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="addenda_kontender_bovedafiscal_71_invoice_fields_form">
            <field name="name">addenda_kontender_bovedafiscal_71_invoice_fields_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="l10n_mx_edi_addendas_base.account_move_addendas_extra_base"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='addendas_extra_fits']" position="inside">
                    <group name="bovadd" string="Addenda Tony BOVEDAFISCAL" 
                        invisible="addenda_type != 'bovadd'" >
                        <group>
                            <field name="l10n_mx_edi_addenda_bovedafiscal_no_pedido"/>
                            <field name="l10n_mx_edi_addenda_bovedafiscal_peso"/>
                        </group>
                        <group>
                            <field name="l10n_mx_edi_addenda_bovedafiscal_cantidad_bultos"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>



    </data>
</odoo>