<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="l10n_mx_edi_addenda_bovedafiscal" model="l10n_mx_edi.addenda">
            <field name="name">Tony BOVEDAFISCAL</field>
            <field name="arch" type="xml">
                <t t-xml-node="addenda">
                    <t t-set="sumary" t-value="record.getAddendaSumary()" />
                    <t t-set="sale_model" t-value="'sale_line_ids' in record.invoice_line_ids._fields"/>
                    <t t-set="sale_id" t-value="record.mapped('invoice_line_ids.sale_line_ids.order_id') if sale_model else False"/>
                    <t t-set="pickings" t-value="sale_id.picking_ids.filtered(lambda x: x.state == 'done' and x.date_done)" />
                    <bovadd:BOVEDAFISCAL xmlns:bovadd="http://kontender.mx/namespace/boveda" xmlns:kon="http://kontender.mx/namespace" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://kontender.mx/namespace/boveda http://kontender.mx/namespace/boveda/BOVEDAFISCAL.xsd http://kontender.mx/namespace http://kontender.mx/namespace/AddendaK.xsd">
                        <bovadd:Pedido t-att-Folio="record.l10n_mx_edi_addenda_bovedafiscal_no_pedido"/>
                        <bovadd:Factura t-att-Peso="'{:0,.0f}'.format(record.l10n_mx_edi_addenda_bovedafiscal_peso)"/>
                        <bovadd:TotalBultos t-att-Cantidad="'{:0,.0f}'.format(record.l10n_mx_edi_addenda_bovedafiscal_cantidad_bultos)"/>
                        <bovadd:ConceptosKDSU>
                            <t t-foreach="record.invoice_line_ids.filtered(lambda inv: not inv.display_type)" t-as="line">
                                <bovadd:ConceptoKDSU t-att-cantPzas="'{:0,.0f}'.format(line.quantity)" t-att-codigoTony="line.product_id.x_tony_code" t-att-codigoProveedor="line.product_id.default_code"/>
                            </t>
                        </bovadd:ConceptosKDSU>
                    </bovadd:BOVEDAFISCAL>
                </t>
            </field>
        </record>
    </data>
</odoo>